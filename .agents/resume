#!/usr/bin/env bash
set -euo pipefail

node_version="22.18.0"
node_home="$HOME/.local/share/node-v${node_version}-linux-x64"

if [[ ! -x "$node_home/bin/node" ]]; then
	printf 'Node.js v%s is missing; rerun .agents/setup\n' "$node_version" >&2
	exit 1
fi

export PATH="$node_home/bin:$PATH"
printf 'Orb ready (Node.js %s, npm %s)\n' "$(node --version)" "$(npm --version)"
